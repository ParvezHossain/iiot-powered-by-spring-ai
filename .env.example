COMPOSE_FILE=docker-compose.yml:docker-compose.ai.yml

APP_PORT=8080
POSTGRES_PORT=5432
OLLAMA_PORT=11434

POSTGRES_PASSWORD=iiot_dev

AGENT_MODEL=qwen2.5:1.5b
RAG_ANSWER_MODEL=qwen2.5:1.5b

RAG_ENABLED=false
RAG_INGEST_ON_STARTUP=true
RAG_BATCH_SIZE=16
AGENT_ENABLED=false
MCP_ENABLED=false

ALERTS_ENABLED=true
ALERTS_GMAIL_ENABLED=false
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
ALERT_EMAIL_TO=

# MCP uses an ADMIN user JWT; no separate MCP API key is required.

# Generate with:
# openssl rand -base64 32
AUTH_JWT_SECRET=REPLACE_WITH_A_NEW_BASE64_JWT_SECRET

AUTH_ISSUER=iiot-api
AUTH_AUDIENCE=iiot-spa
AUTH_ACCESS_TTL=PT15M
AUTH_REFRESH_TTL=P7D
AUTH_BCRYPT_STRENGTH=12
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT=PT15M
AUTH_REQUESTS_PER_MINUTE=30

# Required only until the first administrator is created.
AUTH_INITIAL_ADMIN_USERNAME=
AUTH_INITIAL_ADMIN_EMAIL=
AUTH_INITIAL_ADMIN_PASSWORD=

# Blank means same-origin requests only.
AUTH_CORS_ORIGINS=

SIMULATOR_ENABLED=true
SIMULATOR_MACHINE_COUNT=5
SIMULATOR_INTERVAL_MS=5000
SIMULATOR_ANOMALY_EVERY_TICKS=12
SIMULATOR_SEED=42
